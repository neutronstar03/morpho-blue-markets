{
  "name": "morpho-blue-markets",
  "type": "module",
  "version": "1.5.9",
  "private": true,
  "description": "An alternative frontend for the Morpho Blue DEFI protocol.",
  "author": {
    "name": "neutronstar03",
    "url": "https://github.com/neutronstar03"
  },
  "license": "The Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/neutronstar03/morpho-blue-markets"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "lint": "eslint . --fix",
    "typecheck": "react-router typegen && tsc",
    "preview:cf": "bun run build && cp -R functions ./build/client/functions && wrangler pages dev ./build/client",
    "deploy:cf": "bun run build && cp -R functions ./build/client/functions && wrangler pages deploy ./build/client --project-name=morpho-blue-markets --branch=main",
    "gen:blacklist:markets": "bun scripts/blacklist-generator.ts",
    "gen:whitelist:collaterals": "bun scripts/collateral-whitelist-generator.ts",
    "gen:whitelist:collaterals:reset": "bun scripts/collateral-whitelist-generator.ts --reset-all",
    "gen:whitelist:collaterals:recheck-unknown": "bun scripts/collateral-whitelist-generator.ts --recheck-unknown --unknown-cooldown-hours 100",
    "gen:oracle-providers": "bun scripts/oracle-provider-generator.ts",
    "gen:all": "bun scripts/blacklist-generator.ts && bun scripts/collateral-whitelist-generator.ts && bun scripts/oracle-provider-generator.ts",
    "artifacts:pull": "bun scripts/pull-artifacts.ts --whitelist",
    "artifacts:pull:all": "bun scripts/pull-artifacts.ts --whitelist --blacklist --unhealthy-markets --oracle-providers",
    "test:ui": "vitest --config vitest.config.ts",
    "snapshot:usds:24164776": "bun tests/scripts/rpc-snapshot01.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@rainbow-me/rainbowkit": "2.2.10",
    "@react-router/node": "7.13.2",
    "@react-router/serve": "7.13.2",
    "@tanstack/react-query": "5.91.3",
    "@wagmi/connectors": "6.2.0",
    "@wagmi/core": "2.22.1",
    "@web3icons/react": "^4.1.17",
    "caniuse-lite": "1.0.30001781",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "16.13.1",
    "graphql-request": "7.4.0",
    "isbot": "5.1.36",
    "lucide-react": "0.577.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "7.13.2",
    "react-router-dom": "7.13.2",
    "tailwind-merge": "3.5.0",
    "use-debounce": "10.1.0",
    "viem": "2.47.6",
    "wagmi": "2.19.5",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@antfu/eslint-config": "6.7.3",
    "@cloudflare/workers-types": "^4.20260412.1",
    "@react-router/dev": "7.13.2",
    "@tailwindcss/vite": "4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.11",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "baseline-browser-mapping": "2.10.10",
    "eslint": "9.39.4",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "8.0.2",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "4.1.1",
    "wrangler": "^4.81.1"
  }
}
